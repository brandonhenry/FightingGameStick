{
  "name": "fighting-game-stick",
  "productName": "Fighting Game Stick",
  "version": "0.1.1",
  "description": "Turn a keyboard into a virtual Xbox controller with a focused fighting-game interface.",
  "author": "Fighting Game Stick contributors",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:site": "node scripts/build-site.mjs",
    "fetch:driver": "node scripts/fetch-vigembus.mjs",
    "build:host": "dotnet publish native/FightingGameStick.InputHost/FightingGameStick.InputHost.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o resources/input-host/win-x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  }
}
